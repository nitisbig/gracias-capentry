---
import "../styles/light.css";
import { site, serviceGroups, reviews, projects } from "../data/site";

const title = `${site.name} — ${site.tagline}`;
const description = `${site.name}: interior & exterior painting, carpentry, decks, fencing, flooring, remodeling and home repairs serving ${site.area}. Rated ${site.rating} stars. Call ${site.phone}.`;

const heroImg = "/works/tenth.webp";
const aboutImg = "/works/third.webp";

// Bento layout spans for the work grid, matched to the projects[] order.
const spans = [
  "lg:col-span-2 lg:row-span-2",
  "",
  "lg:col-span-2",
  "",
  "",
  "",
  "lg:row-span-2",
  "",
  "lg:col-span-2",
];
const work = projects.map((p, i) => ({ ...p, span: spans[i] ?? "" }));

const icons: Record<string, string> = {
  paint:
    '<rect x="3" y="4" width="13" height="6" rx="1"/><path d="M16 7h3a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-7v3"/><rect x="9" y="16" width="4" height="5" rx="1"/>',
  deck:
    '<path d="M3 7h18"/><path d="M3 12h18"/><path d="M3 17h18"/><path d="M6 7v10"/><path d="M18 7v10"/>',
  floor:
    '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 10h18M3 15h18M9 4v6M15 10v5M7 15v5M13 4v6"/>',
  remodel:
    '<path d="M3 21V9l9-6 9 6v12"/><path d="M9 21v-6h6v6"/>',
  repair:
    '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6 2 2 6-6a4 4 0 0 0 5.4-5.4l-2.3 2.3-1.7-1.7z"/>',
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  name: site.name,
  description,
  telephone: site.phone,
  areaServed: "Mississippi",
  address: {
    "@type": "PostalAddress",
    addressRegion: "MS",
    addressCountry: "US",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: site.rating,
    reviewCount: site.reviewCount,
  },
};

const navLinks = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#work", label: "Gallery" },
  { href: "#reviews", label: "Reviews" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={site.logo} />
    <link rel="apple-touch-icon" href={site.logo} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf4ea" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={site.logo} />
    <meta name="twitter:image" content={site.logo} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Hanken+Grotesk:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="relative">
    <div class="grain" aria-hidden="true"></div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-honey focus:px-5 focus:py-2 focus:text-warmwhite"
    >
      Skip to content
    </a>

    <!-- ===== NAV ===== -->
    <header
      id="nav"
      class="fixed inset-x-0 top-0 z-40 transition-all duration-500"
    >
      <div
        class="mx-auto mt-3 flex max-w-7xl items-center justify-between rounded-full px-5 py-3 transition-all duration-500 sm:px-7"
        id="navbar"
      >
        <a
          href="#top"
          class="group flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-walnut sm:text-xl"
        >
          <img
            src={site.logo}
            alt={`${site.shortName} logo`}
            width="40"
            height="40"
            class="h-9 w-9 rounded-full object-cover shadow-sm ring-1 ring-walnut/10 transition-transform duration-300 group-hover:scale-105 sm:h-10 sm:w-10"
          />
          The Maintenance Man<span class="text-honey">.</span>
        </a>

        <nav class="hidden items-center gap-9 md:flex">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                class="text-sm font-medium text-walnut-soft transition-colors hover:text-honey"
              >
                {l.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3">
          <a
            href={site.phoneHref}
            class="hidden rounded-full bg-walnut px-6 py-2.5 text-sm font-semibold text-paper transition-all hover:bg-honey hover:text-warmwhite sm:inline-flex"
          >
            Call {site.phone}
          </a>
          <button
            id="menuBtn"
            aria-label="Open menu"
            class="grid h-10 w-10 place-items-center rounded-full bg-walnut/5 text-walnut md:hidden"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>

      <!-- mobile menu -->
      <div
        id="mobileMenu"
        class="mx-3 mt-2 hidden overflow-hidden rounded-3xl bg-warmwhite/95 p-4 shadow-xl backdrop-blur md:hidden"
      >
        {
          navLinks.map((l) => (
            <a
              href={l.href}
              class="mobile-link block rounded-xl px-4 py-3 text-base font-medium text-walnut hover:bg-cream"
            >
              {l.label}
            </a>
          ))
        }
        <a
          href={site.phoneHref}
          class="mt-2 block rounded-full bg-honey px-4 py-3 text-center font-semibold text-warmwhite"
        >
          Call {site.phone}
        </a>
      </div>
    </header>

    <main id="main">
      <!-- ===== HERO ===== -->
      <section id="top" class="relative mesh overflow-hidden pt-32 pb-24 sm:pt-40">
        <!-- floating blobs -->
        <div
          class="float-slow blob absolute -left-24 top-40 -z-0 h-72 w-72 bg-honey-bright/25 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="float-slower blob-2 absolute right-[-6rem] top-10 h-80 w-80 bg-clay/20 blur-3xl"
          aria-hidden="true"
        ></div>

        <div
          class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.05fr_0.95fr]"
        >
          <div class="reveal">
            <p class="eyebrow">{site.tagline}</p>
            <h1
              class="display mt-6 text-5xl text-walnut sm:text-6xl lg:text-7xl"
            >
              Painted by hand,
              <span class="display-ital block text-honey">built to last.</span>
            </h1>
            <p
              class="mt-7 max-w-xl text-lg leading-relaxed text-walnut-soft"
            >
              From interior and exterior painting to decks, fencing, flooring
              and full remodels — {site.name} brings warm, dependable
              workmanship to homes across {site.area}.
            </p>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:items-center">
              <a
                href={site.phoneHref}
                class="group inline-flex items-center justify-center gap-2 rounded-full bg-honey px-8 py-4 text-sm font-bold tracking-wide text-warmwhite shadow-lg shadow-honey/30 transition-all hover:-translate-y-0.5 hover:bg-honey-deep"
              >
                Call {site.phone}
                <svg class="transition-transform group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <a
                href="#work"
                class="inline-flex items-center justify-center rounded-full border border-walnut/20 px-8 py-4 text-sm font-semibold tracking-wide text-walnut transition-all hover:border-honey hover:text-honey"
              >
                See Our Work
              </a>
            </div>

            <div class="mt-10 flex items-center gap-4">
              <span class="text-lg tracking-widest text-honey">★★★★★</span>
              <p class="text-sm text-walnut-soft">
                <span class="font-bold text-walnut">{site.rating}/5</span> from {
                  site.reviewCount
                } Google reviews
              </p>
            </div>
          </div>

          <!-- organic hero image -->
          <div class="reveal relative" style="transition-delay:160ms">
            <div
              class="morphing relative overflow-hidden shadow-2xl shadow-honey-deep/20"
            >
              <img
                src={heroImg}
                alt="A freshly painted craftsman home with a finished front porch"
                class="aspect-[4/5] h-full w-full object-cover"
                fetchpriority="high"
              />
            </div>
            <!-- floating rating chip -->
            <div
              class="float-slow soft-card absolute -bottom-6 -left-6 flex items-center gap-3 rounded-2xl px-5 py-4"
            >
              <div
                class="grid h-11 w-11 place-items-center rounded-full bg-honey/15 font-display text-lg font-semibold text-honey-deep"
              >
                {site.rating}
              </div>
              <div class="leading-tight">
                <p class="text-sm font-bold text-walnut">Five-star rated</p>
                <p class="text-xs text-walnut-mute">{site.reviewCount} happy clients</p>
              </div>
            </div>
            <!-- floating craftsman chip -->
            <div
              class="float-slower soft-card absolute -right-4 top-8 hidden rounded-2xl px-4 py-3 sm:block"
            >
              <p class="text-xs uppercase tracking-widest text-honey-deep">Your craftsman</p>
              <p class="font-display text-lg font-semibold text-walnut">{site.craftsman}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== MARQUEE ===== -->
      <div class="overflow-hidden border-y border-walnut/10 bg-walnut py-4">
        <div class="marquee-track text-paper">
          {
            Array.from({ length: 2 }).map(() => (
              <span class="flex items-center">
                {[
                  "Interior Painting",
                  "Exterior Painting",
                  "Decks & Fencing",
                  "Flooring & Tile",
                  "Remodeling",
                  "Drywall Repair",
                  "Custom Carpentry",
                  "Home Repairs",
                ].map((t) => (
                  <span class="flex items-center">
                    <span class="px-8 font-display text-lg italic">{t}</span>
                    <span class="text-honey">✦</span>
                  </span>
                ))}
              </span>
            ))
          }
        </div>
      </div>

      <!-- ===== ABOUT ===== -->
      <section id="about" class="relative bg-paper py-24 sm:py-32">
        <div
          class="mx-auto grid max-w-7xl items-center gap-16 px-5 sm:px-8 lg:grid-cols-2"
        >
          <div class="reveal relative order-2 lg:order-1">
            <div class="blob-2 relative overflow-hidden shadow-2xl shadow-honey-deep/15">
              <img
                src={aboutImg}
                alt="A remodeled kitchen with fresh cabinets, counters and tile"
                class="aspect-square h-full w-full object-cover"
              />
            </div>
            <div
              class="float-slow blob absolute -bottom-8 -right-6 -z-10 h-40 w-40 bg-sage-soft/50 blur-2xl"
              aria-hidden="true"
            ></div>
          </div>

          <div class="reveal order-1 lg:order-2" style="transition-delay:120ms">
            <p class="eyebrow">The Crew</p>
            <h2 class="display mt-5 text-4xl text-walnut sm:text-5xl">
              Superior craftsmanship,
              <span class="display-ital text-honey">made personal.</span>
            </h2>
            <p class="mt-6 text-lg leading-relaxed text-walnut-soft">
              {site.name} is built on a simple promise from {site.craftsman}:
              measure twice, build once, and treat every home like it's our own.
              Whether it's a fresh coat of paint or a deck made for Mississippi
              summers, the work is precise, honest, and finished with care.
            </p>
            <p class="mt-4 text-lg leading-relaxed text-walnut-soft">
              Responsive, dependable, and meticulous — the same reasons
              neighbors across {site.area} keep coming back.
            </p>

            <dl class="mt-10 grid grid-cols-3 gap-6">
              {
                [
                  { n: site.rating, l: "Star rating" },
                  { n: `${site.reviewCount}`, l: "Google reviews" },
                  { n: "15+", l: "Services offered" },
                ].map((s) => (
                  <div class="border-l-2 border-honey/40 pl-4">
                    <dt class="font-display text-4xl font-medium text-walnut">{s.n}</dt>
                    <dd class="mt-1 text-sm text-walnut-mute">{s.l}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </section>

      <!-- ===== SERVICES ===== -->
      <section id="services" class="relative bg-cream/60 py-24 sm:py-32">
        <!-- top wave -->
        <div class="pointer-events-none absolute -top-px left-0 w-full leading-none" aria-hidden="true">
          <svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="h-[60px] w-full"><path fill="#faf4ea" d="M0,64 C240,10 480,10 720,40 C960,70 1200,90 1440,48 L1440,0 L0,0 Z"/></svg>
        </div>

        <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
          <div class="reveal mx-auto max-w-2xl text-center">
            <p class="eyebrow">What We Do</p>
            <h2 class="display mt-5 text-4xl text-walnut sm:text-5xl">
              One team, <span class="display-ital text-honey">every detail.</span>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-walnut-soft">
              From a fresh coat of paint to the trim you run your hand along —
              here's how we can help.
            </p>
          </div>

          <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              serviceGroups.map((g, i) => (
                <article
                  class={`reveal soft-card group rounded-[1.75rem] p-8 transition-all duration-500 hover:-translate-y-1.5 ${i === 0 ? "lg:col-span-2 lg:row-span-1" : ""}`}
                  style={`transition-delay:${i * 70}ms`}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <span
                        class="mb-5 grid h-14 w-14 place-items-center rounded-2xl bg-honey/12 text-honey-deep transition-colors group-hover:bg-honey group-hover:text-warmwhite"
                      >
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[g.icon]} />
                      </span>
                      <h3 class="font-display text-2xl font-medium text-walnut">{g.title}</h3>
                    </div>
                    <span class="font-display text-2xl text-honey/30">0{i + 1}</span>
                  </div>
                  <p class="mt-3 leading-relaxed text-walnut-soft">{g.blurb}</p>
                  <ul class={`mt-6 gap-x-6 gap-y-2 ${i === 0 ? "grid sm:grid-cols-2" : "flex flex-col"}`}>
                    {g.items.map((it) => (
                      <li class="flex items-start gap-2.5 text-sm text-walnut-soft">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-honey" />
                        {it}
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ===== WORK ===== -->
      <section id="work" class="relative bg-paper py-24 sm:py-32">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="reveal flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow">Selected Work</p>
              <h2 class="display mt-5 text-4xl text-walnut sm:text-5xl">
                A few things <span class="display-ital text-honey">we've made.</span>
              </h2>
            </div>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 text-sm font-semibold text-walnut transition-colors hover:text-honey"
            >
              Start your project
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>

          <div class="mt-14 grid auto-rows-[230px] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {
              work.map((w, i) => (
                <figure
                  class={`reveal group relative overflow-hidden rounded-[1.75rem] shadow-lg shadow-honey-deep/10 ${w.span}`}
                  style={`transition-delay:${i * 60}ms`}
                >
                  <img
                    src={w.img}
                    alt={`${w.label} — ${w.category} by ${site.shortName}`}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-walnut/70 via-walnut/5 to-transparent opacity-80"></div>
                  <figcaption class="absolute bottom-5 left-5 right-5">
                    <span class="block text-xs font-semibold uppercase tracking-widest text-honey-bright">
                      {w.category}
                    </span>
                    <span class="mt-1 block font-display text-lg font-medium text-paper">
                      {w.label}
                    </span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ===== REVIEWS ===== -->
      <section id="reviews" class="relative bg-cream/60 py-24 sm:py-32">
        <div class="pointer-events-none absolute -top-px left-0 w-full leading-none" aria-hidden="true">
          <svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="h-[60px] w-full"><path fill="#faf4ea" d="M0,40 C240,90 480,90 720,50 C960,12 1200,12 1440,56 L1440,0 L0,0 Z"/></svg>
        </div>

        <div class="relative mx-auto max-w-6xl px-5 sm:px-8">
          <div class="reveal mx-auto max-w-2xl text-center">
            <p class="eyebrow">Kind Words</p>
            <h2 class="display mt-5 text-4xl text-walnut sm:text-5xl">
              Loved by <span class="display-ital text-honey">Mississippi homes.</span>
            </h2>
            <div class="mt-5 flex items-center justify-center gap-3">
              <span class="text-lg tracking-widest text-honey">★★★★★</span>
              <p class="text-sm text-walnut-soft">
                <span class="font-bold text-walnut">{site.rating}/5</span> · {site.reviewCount} Google reviews
              </p>
            </div>
          </div>

          <div class="mt-14 columns-1 gap-6 sm:columns-2 lg:columns-3 [&>*]:mb-6">
            {
              reviews.map((r, i) => (
                <figure
                  class="reveal soft-card break-inside-avoid rounded-[1.5rem] p-7"
                  style={`transition-delay:${i * 60}ms`}
                >
                  <span class="text-base tracking-widest text-honey">★★★★★</span>
                  <blockquote class="mt-4 font-display text-lg italic leading-relaxed text-walnut">
                    "{r.quote}"
                  </blockquote>
                  <figcaption class="mt-5 flex items-center gap-3">
                    <span
                      class="grid h-11 w-11 place-items-center rounded-full bg-honey/15 font-display text-base font-semibold text-honey-deep"
                    >
                      {r.name.split(" ").map((p) => p[0]).join("").slice(0, 2)}
                    </span>
                    <span class="leading-tight">
                      <span class="block font-semibold text-walnut">{r.name}</span>
                      {r.service && (
                        <span class="block text-xs text-walnut-mute">{r.service}</span>
                      )}
                    </span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ===== CONTACT ===== -->
      <section id="contact" class="relative bg-paper py-24 sm:py-32">
        <div class="mx-auto max-w-6xl px-5 sm:px-8">
          <div
            class="reveal mesh relative overflow-hidden rounded-[2.5rem] border border-honey/20 px-8 py-16 text-center shadow-2xl shadow-honey-deep/15 sm:px-16 sm:py-20"
          >
            <div
              class="float-slow blob absolute -left-16 -top-10 h-56 w-56 bg-honey-bright/30 blur-3xl"
              aria-hidden="true"
            ></div>
            <div
              class="float-slower blob-2 absolute -bottom-16 -right-12 h-64 w-64 bg-clay/25 blur-3xl"
              aria-hidden="true"
            ></div>

            <div class="relative">
              <p class="eyebrow">Work With Us</p>
              <h2 class="display mx-auto mt-5 max-w-3xl text-4xl text-walnut sm:text-6xl">
                Let's build something
                <span class="display-ital text-honey">lasting.</span>
              </h2>
              <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-walnut-soft">
                Tell us about your project and we'll get you a straight,
                no-pressure quote — often the same day.
              </p>

              <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
                <a
                  href={site.phoneHref}
                  class="group inline-flex items-center justify-center gap-2 rounded-full bg-walnut px-9 py-4 text-sm font-bold tracking-wide text-paper transition-all hover:-translate-y-0.5 hover:bg-honey hover:text-warmwhite"
                >
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  Call {site.phone}
                </a>
                <a
                  href="#work"
                  class="inline-flex items-center justify-center rounded-full border border-walnut/25 bg-warmwhite/60 px-9 py-4 text-sm font-semibold tracking-wide text-walnut backdrop-blur transition-all hover:border-honey hover:text-honey"
                >
                  See Our Work
                </a>
              </div>
              <p class="mt-8 text-sm text-walnut-mute">
                Serving {site.areaLong}
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="border-t border-walnut/10 bg-cream/70 py-14">
      <div
        class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 md:grid-cols-3"
      >
        <div>
          <p class="flex items-center gap-3 font-display text-2xl font-semibold text-walnut">
            <img
              src={site.logo}
              alt={`${site.shortName} logo`}
              width="48"
              height="48"
              class="h-11 w-11 rounded-full object-cover shadow-sm ring-1 ring-walnut/10"
            />
            The Maintenance Man<span class="text-honey">.</span>
          </p>
          <p class="mt-3 max-w-xs text-sm leading-relaxed text-walnut-soft">
            {site.tagline}, handcrafted for homes across {site.area}.
          </p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm text-walnut-soft">
            <span class="tracking-widest text-honey">★★★★★</span> {site.rating}/5
          </span>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-[0.28em] text-honey-deep">Explore</p>
          <ul class="mt-4 space-y-2.5">
            {
              navLinks.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-walnut-soft transition-colors hover:text-honey">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="text-xs font-bold uppercase tracking-[0.28em] text-honey-deep">Get in Touch</p>
          <ul class="mt-4 space-y-2.5 text-sm text-walnut-soft">
            <li>
              <a href={site.phoneHref} class="transition-colors hover:text-honey">{site.phone}</a>
            </li>
            <li>{site.craftsman}, Owner</li>
            <li>{site.areaLong}</li>
          </ul>
        </div>
      </div>

      <div
        class="mx-auto mt-12 max-w-7xl border-t border-walnut/10 px-5 pt-6 text-xs text-walnut-mute sm:px-8"
      >
        © <span id="year"></span> {site.name}. All rights reserved.
      </div>
    </footer>

    <script>
      // nav scroll state
      const navbar = document.getElementById("navbar");
      const onScroll = () => {
        if (!navbar) return;
        if (window.scrollY > 40) {
          navbar.classList.add("bg-warmwhite/80", "shadow-lg", "backdrop-blur-md");
        } else {
          navbar.classList.remove("bg-warmwhite/80", "shadow-lg", "backdrop-blur-md");
        }
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // mobile menu
      const btn = document.getElementById("menuBtn");
      const menu = document.getElementById("mobileMenu");
      btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
      document
        .querySelectorAll(".mobile-link")
        .forEach((l) => l.addEventListener("click", () => menu?.classList.add("hidden")));

      // year
      const y = document.getElementById("year");
      if (y) y.textContent = String(new Date().getFullYear());

      // reveal
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
