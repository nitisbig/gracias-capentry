---
const projects = [
  {
    title: "Custom Wardrobes",
    tag: "Storage & Closets",
    img: "https://images.unsplash.com/photo-1558997519-83ea9252edf8?auto=format&fit=crop&w=1000&q=80",
    span: "lg:col-span-2 lg:row-span-2",
  },
  {
    title: "Decks & Outdoor",
    tag: "Exterior Build",
    img: "https://images.unsplash.com/photo-1597211833712-5e41faa202ea?auto=format&fit=crop&w=900&q=80",
    span: "",
  },
  {
    title: "Finish & Trim",
    tag: "Detail Work",
    img: "https://images.unsplash.com/photo-1600585152220-90363fe7e115?auto=format&fit=crop&w=900&q=80",
    span: "",
  },
  {
    title: "Shelving & Storage",
    tag: "Built-Ins",
    img: "https://images.unsplash.com/photo-1594620302200-9a762244a156?auto=format&fit=crop&w=900&q=80",
    span: "",
  },
  {
    title: "Remodeling",
    tag: "Interiors",
    img: "https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?auto=format&fit=crop&w=900&q=80",
    span: "",
  },
];
---

<section id="work" class="relative bg-ink py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal max-w-2xl">
      <p class="eyebrow">Our Work</p>
      <div class="hairline mt-5"></div>
      <h2 class="heading-xl mt-6 text-4xl text-bone sm:text-5xl">
        Built for Homes Across <span class="text-gold">Dallas</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-bone/70">
        A glimpse of the craftsmanship we bring to every project — precise,
        durable, and finished with care.
      </p>
    </div>

    <div
      class="mt-14 grid auto-rows-[220px] grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        projects.map((p, i) => (
          <article
            class={`reveal group relative overflow-hidden rounded-sm ${p.span}`}
            style={`transition-delay:${i * 70}ms`}
          >
            <img
              src={p.img}
              alt={p.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"
            />
            <div class="absolute inset-x-0 bottom-0 p-6">
              <p class="font-display text-[0.65rem] uppercase tracking-[0.28em] text-gold">
                {p.tag}
              </p>
              <h3 class="mt-1 font-display text-xl font-700 uppercase tracking-[0.04em] text-bone">
                {p.title}
              </h3>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
