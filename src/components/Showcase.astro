---
import { site } from "../data/site";

const projects = [
  {
    img: "https://images.unsplash.com/photo-1556228453-efd6c1ff04f6?auto=format&fit=crop&w=1000&q=80",
    label: "Custom Wardrobes",
  },
  {
    img: "https://images.unsplash.com/photo-1600566752355-35792bedcfea?auto=format&fit=crop&w=1000&q=80",
    label: "Shelving & Storage",
  },
  {
    img: "https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&w=1000&q=80",
    label: "Finish & Trim",
  },
];
---

<!-- Taupe monogram band -->
<section class="bg-band py-24 text-center sm:py-28">
  <div class="reveal mx-auto max-w-4xl px-6">
    <span
      class="mx-auto grid h-16 w-16 place-items-center border border-white/60 font-display text-2xl font-light text-white"
      >G</span
    >
    <p class="heading-band mt-8 text-xl sm:text-2xl">
      Residential &nbsp;|&nbsp; Custom Builds &nbsp;|&nbsp; Repairs
    </p>
    <p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-white/75">
      Trusted by homeowners across {site.area} for woodwork that lasts.
    </p>
  </div>
</section>

<!-- Gallery -->
<section id="work" class="bg-bg py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Selected Work</p>
      <div class="hairline mx-auto mt-5"></div>
      <h2 class="heading-xl mt-6 text-3xl text-heading sm:text-5xl">
        A Few Things <span class="text-gold">We've Made</span>
      </h2>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        projects.map((p, i) => (
          <figure
            class="reveal group"
            style={`transition-delay:${i * 90}ms`}
          >
            <div class="overflow-hidden">
              <img
                src={p.img}
                alt={p.label}
                loading="lazy"
                class="aspect-[4/5] w-full object-cover grayscale-[15%] transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
              />
            </div>
            <figcaption
              class="mt-5 text-center font-display text-xs font-semibold uppercase tracking-[0.26em] text-heading"
            >
              {p.label}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="reveal mt-16 text-center">
      <a href="#contact" class="btn-outline">Start Your Project</a>
    </div>
  </div>
</section>
