---
import { serviceGroups } from "../data/site";

const icons: Record<string, string> = {
  paint: `<rect x="3" y="4" width="13" height="6" rx="1"/><path d="M16 7h3a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-7v3"/><rect x="9" y="16" width="4" height="5" rx="1"/>`,
  deck: `<path d="M3 9h18M3 9l3-5h12l3 5M5 9v11M19 9v11M9 9v11M15 9v11"/>`,
  floor: `<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 10h18M3 15h18M9 4v6M15 10v5M7 15v5M13 4v6"/>`,
  remodel: `<path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/>`,
  repair: `<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2-2 2.3-2.3z"/>`,
};
---

<section id="services" class="bg-bg-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Our Services</p>
      <div class="hairline mx-auto mt-5"></div>
      <h2 class="heading-xl mt-6 text-3xl text-heading sm:text-5xl">
        A Full Range of <span class="text-gold">Home Services</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-body">
        From a fresh coat of paint to custom builds, remodels and everyday
        repairs — whatever your home needs, we handle it with care.
      </p>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        serviceGroups.map((group, i) => (
          <article
            class="reveal group flex flex-col bg-bg p-9 transition-colors duration-300 hover:bg-bg-soft"
            style={`transition-delay:${(i % 3) * 80}ms`}
          >
            <div class="flex items-center justify-between">
              <span
                class="flex h-14 w-14 items-center justify-center border border-gold/40 text-gold transition-colors group-hover:bg-gold group-hover:text-white"
              >
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[group.icon]}
                />
              </span>
              <span class="font-display text-2xl font-light text-line">0{i + 1}</span>
            </div>
            <h3
              class="mt-6 font-display text-lg font-semibold uppercase tracking-[0.1em] text-heading"
            >
              {group.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-body">{group.blurb}</p>
            <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
              {group.items.map((item) => (
                <li class="flex items-start gap-3 text-sm text-body">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold" />
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
