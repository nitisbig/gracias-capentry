---
import { serviceGroups } from "../data/site";

const icons: Record<string, string> = {
  wardrobe: `<rect x="4" y="3" width="16" height="18" rx="1"/><line x1="12" y1="3" x2="12" y2="21"/><line x1="9" y1="11" x2="9" y2="13"/><line x1="15" y1="11" x2="15" y2="13"/>`,
  deck: `<path d="M3 9h18M3 9l3-5h12l3 5M5 9v11M19 9v11M9 9v11M15 9v11"/>`,
  trim: `<path d="M4 7h16M4 12h16M4 17h10"/><path d="M18 15l3 2-3 2z"/>`,
  remodel: `<path d="M3 21h18M5 21V8l7-5 7 5v13M9 21v-6h6v6"/>`,
  repair: `<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.3 2.3-2-2 2.3-2.3z"/>`,
};
---

<section id="services" class="relative bg-ink-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">What We Do</p>
      <div class="hairline mx-auto mt-5"></div>
      <h2 class="heading-xl mt-6 text-4xl text-bone sm:text-5xl">
        A Full Range of <span class="text-gold">Carpentry Services</span>
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-bone/70">
        From custom builds to everyday installs and repairs — whatever your home
        needs in wood, we handle it with care.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        serviceGroups.map((group, i) => (
          <article
            class="reveal group flex flex-col rounded-sm border border-bone/10 bg-ink p-8 transition-all duration-300 hover:-translate-y-1 hover:border-gold/40"
            style={`transition-delay:${i * 80}ms`}
          >
            <span
              class="flex h-14 w-14 items-center justify-center rounded-sm border border-gold/30 text-gold transition-colors group-hover:bg-gold group-hover:text-ink"
            >
              <svg
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[group.icon]}
              />
            </span>
            <h3
              class="mt-6 font-display text-xl font-700 uppercase tracking-[0.06em] text-bone"
            >
              {group.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-stone">{group.blurb}</p>
            <ul class="mt-6 space-y-2.5 border-t border-bone/10 pt-6">
              {group.items.map((item) => (
                <li class="flex items-start gap-3 text-sm text-bone/80">
                  <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-gold" />
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
