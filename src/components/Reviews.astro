---
import { reviews, site } from "../data/site";

const initials = (name: string) =>
  name
    .split(" ")
    .map((n) => n[0])
    .slice(0, 2)
    .join("");
---

<section id="reviews" class="relative bg-ink-soft py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Client Reviews</p>
      <div class="hairline mx-auto mt-5"></div>
      <h2 class="heading-xl mt-6 text-4xl text-bone sm:text-5xl">
        Rated <span class="text-gold">{site.rating} / 5</span> by Our Clients
      </h2>
      <div class="mt-5 flex items-center justify-center gap-3">
        <span class="text-xl tracking-widest text-gold">★★★★★</span>
        <span class="text-sm text-stone">{site.reviewCount} Google reviews</span>
      </div>
    </div>

    <div class="mt-16 columns-1 gap-6 md:columns-2 lg:columns-3 [&>*]:mb-6">
      {
        reviews.map((r, i) => (
          <figure
            class="reveal break-inside-avoid rounded-sm border border-bone/10 bg-ink p-8"
            style={`transition-delay:${i * 70}ms`}
          >
            <div class="text-sm tracking-widest text-gold">★★★★★</div>
            <blockquote class="mt-4 leading-relaxed text-bone/85">
              “{r.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4 border-t border-bone/10 pt-5">
              <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold/40 font-display text-sm font-700 text-gold">
                {initials(r.name)}
              </span>
              <span>
                <span class="block font-display text-sm font-600 uppercase tracking-[0.1em] text-bone">
                  {r.name}
                </span>
                {r.service && (
                  <span class="block text-xs text-stone">{r.service}</span>
                )}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
