---
import { site, reviews } from "../data/site";
---

<section id="reviews" class="bg-bg-soft py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Kind Words</p>
      <div class="hairline mx-auto mt-5"></div>
      <h2 class="heading-xl mt-6 text-3xl text-heading sm:text-5xl">
        Loved by <span class="text-gold">Dallas Homes</span>
      </h2>
      <div class="mt-6 flex items-center justify-center gap-3">
        <span class="tracking-[0.25em] text-gold">★★★★★</span>
        <span class="text-sm text-body">
          {site.rating}/5 · {site.reviewCount} Google reviews
        </span>
      </div>
    </div>

    <div class="mt-16 columns-1 gap-6 md:columns-2 lg:columns-3 [&>*]:mb-6">
      {
        reviews.map((r, i) => (
          <figure
            class="reveal break-inside-avoid border border-line bg-bg p-8"
            style={`transition-delay:${(i % 3) * 80}ms`}
          >
            <span class="tracking-[0.2em] text-gold">★★★★★</span>
            <blockquote class="mt-5 leading-relaxed text-heading">
              &ldquo;{r.quote}&rdquo;
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-line pt-5">
              <span
                class="grid h-11 w-11 place-items-center rounded-full bg-bg-soft font-display text-sm font-semibold text-gold"
              >
                {r.name.split(" ").map((p) => p[0]).join("").slice(0, 2)}
              </span>
              <span class="leading-tight">
                <span class="block font-display text-sm font-semibold uppercase tracking-[0.12em] text-heading">
                  {r.name}
                </span>
                {r.service && (
                  <span class="block text-xs text-muted">{r.service}</span>
                )}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
