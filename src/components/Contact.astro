---
import { site } from "../data/site";
---

<section id="contact" class="bg-band py-28 text-center sm:py-36">
  <div class="reveal mx-auto max-w-3xl px-6">
    <p
      class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.34em] text-white/70"
    >
      Let's Build Together
    </p>
    <h2 class="heading-band mt-6 text-4xl sm:text-6xl">Work With Us</h2>
    <p class="mx-auto mt-8 max-w-xl leading-relaxed text-white/80">
      Tell us about your project and we'll get you a straight, no-pressure
      quote — often the same day. Serving {site.area}.
    </p>

    <div class="mt-11 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={site.phoneHref}
        class="inline-flex items-center justify-center gap-2 border border-white bg-white px-9 py-4 font-display text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-heading transition-all hover:bg-transparent hover:text-white"
      >
        Call {site.phone}
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center justify-center border border-white/70 px-9 py-4 font-display text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-white transition-all hover:bg-white hover:text-heading"
      >
        Email Us
      </a>
    </div>
  </div>
</section>
