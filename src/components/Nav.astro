---
import { site } from "../data/site";

const links = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#work", label: "Our Work" },
  { href: "#reviews", label: "Reviews" },
  { href: "#contact", label: "Contact" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
  data-nav
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8"
  >
    <a href="#top" class="group flex items-center gap-3">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-md border border-gold/50 font-display text-lg font-bold text-gold transition-colors group-hover:bg-gold group-hover:text-ink"
      >
        G
      </span>
      <span class="leading-tight">
        <span
          class="block font-display text-sm font-700 uppercase tracking-[0.18em] text-bone"
          >Garcia's</span
        >
        <span
          class="block font-display text-[0.65rem] uppercase tracking-[0.3em] text-stone"
          >Wood &amp; More</span
        >
      </span>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="font-display text-xs font-600 uppercase tracking-[0.2em] text-bone/80 transition-colors hover:text-gold"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="rounded-sm border border-gold bg-gold px-5 py-2.5 font-display text-xs font-700 uppercase tracking-[0.18em] text-ink transition-all hover:bg-gold-bright"
      >
        Call Now
      </a>
    </div>

    <button
      type="button"
      data-menu-btn
      aria-label="Open menu"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center text-bone lg:hidden"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    data-menu
    class="pointer-events-none fixed inset-0 z-40 flex translate-y-[-100%] flex-col bg-ink/98 opacity-0 backdrop-blur transition-all duration-500 lg:hidden"
  >
    <div class="flex items-center justify-between px-5 py-5">
      <span class="font-display text-sm uppercase tracking-[0.2em] text-bone"
        >Menu</span
      >
      <button
        type="button"
        data-menu-close
        aria-label="Close menu"
        class="flex h-10 w-10 items-center justify-center text-bone"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="6" y1="18" x2="18" y2="6"></line>
        </svg>
      </button>
    </div>
    <div class="flex flex-1 flex-col justify-center gap-2 px-8">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-menu-link
            class="border-b border-bone/10 py-4 font-display text-2xl uppercase tracking-[0.12em] text-bone transition-colors hover:text-gold"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="mt-6 rounded-sm bg-gold px-6 py-4 text-center font-display text-sm font-700 uppercase tracking-[0.18em] text-ink"
      >
        Call {site.phone}
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector("[data-nav]");
  const onScroll = () => {
    if (window.scrollY > 40) nav?.classList.add("nav-scrolled");
    else nav?.classList.remove("nav-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const menu = document.querySelector("[data-menu]");
  const open = () => {
    menu?.classList.remove("translate-y-[-100%]", "opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
  };
  const close = () => {
    menu?.classList.add("translate-y-[-100%]", "opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
  };
  document.querySelector("[data-menu-btn]")?.addEventListener("click", open);
  document.querySelector("[data-menu-close]")?.addEventListener("click", close);
  for (const l of document.querySelectorAll("[data-menu-link]"))
    l.addEventListener("click", close);
</script>

<style>
  [data-nav].nav-scrolled {
    background-color: color-mix(in srgb, #14110f 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid color-mix(in srgb, #b89047 22%, transparent);
  }
</style>
