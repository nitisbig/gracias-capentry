---
import { site } from "../data/site";
const year = new Date().getFullYear();

const links = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#work", label: "Our Work" },
  { href: "#reviews", label: "Reviews" },
  { href: "#contact", label: "Contact" },
];
---

<footer class="border-t border-bone/10 bg-ink-soft">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="flex items-center gap-3">
          <span
            class="flex h-10 w-10 items-center justify-center rounded-md border border-gold/50 font-display text-lg font-bold text-gold"
            >G</span
          >
          <span class="font-display text-sm uppercase tracking-[0.18em] text-bone"
            >{site.name}</span
          >
        </div>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-stone">
          Handcrafted carpentry and custom woodwork built to last, serving {
            site.area
          }.
        </p>
      </div>

      <div>
        <h3 class="eyebrow">Explore</h3>
        <ul class="mt-5 space-y-3">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="text-sm text-bone/80 transition-colors hover:text-gold"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="eyebrow">Get in Touch</h3>
        <ul class="mt-5 space-y-3 text-sm text-bone/80">
          <li>
            <a href={site.phoneHref} class="transition-colors hover:text-gold"
              >{site.phone}</a
            >
          </li>
          <li>{site.area}</li>
          <li class="flex items-center gap-2 pt-1">
            <span class="text-gold">★★★★★</span>
            <span class="text-stone">{site.rating} · {site.reviewCount} reviews</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-bone/10 pt-8 text-xs text-stone sm:flex-row"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="uppercase tracking-[0.2em]">Crafted in Dallas, Texas</p>
    </div>
  </div>
</footer>
