---
import { site } from "../data/site";
const year = new Date().getFullYear();

const links = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#work", label: "Gallery" },
  { href: "#reviews", label: "Reviews" },
  { href: "#contact", label: "Contact" },
];
---

<footer class="bg-bg pt-20">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <!-- Brand row -->
    <div class="flex flex-col items-center text-center">
      <img
        src={site.logo}
        alt={`${site.shortName} logo`}
        width="72"
        height="72"
        class="h-16 w-16 rounded-full object-cover shadow-md ring-1 ring-gold/40"
      />
      <p
        class="mt-5 font-display text-sm font-semibold uppercase tracking-[0.3em] text-heading"
      >
        {site.name}
      </p>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-body">
        {site.tagline}, handcrafted for homes across {site.area}.
      </p>
      <span class="mt-4 inline-flex items-center gap-2 text-sm text-body">
        <span class="tracking-[0.2em] text-gold">★★★★★</span>
        {site.rating} · {site.reviewCount} reviews
      </span>
    </div>

    <!-- Links row -->
    <nav
      class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-4 border-t border-line pt-10"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-body transition-colors hover:text-gold"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <!-- Contact strip -->
    <div
      class="mt-10 flex flex-col items-center justify-center gap-3 text-sm text-body sm:flex-row sm:gap-8"
    >
      <a href={site.phoneHref} class="transition-colors hover:text-gold">
        {site.phone}
      </a>
      <span class="hidden h-3 w-px bg-line sm:block"></span>
      <span>{site.areaLong}</span>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="mt-14 border-t border-line">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-5 py-7 text-xs text-muted sm:flex-row sm:px-8"
    >
      <p>© {year} {site.name}. All rights reserved.</p>
      <p class="uppercase tracking-[0.24em]">Proudly serving {site.area}</p>
    </div>
  </div>
</footer>
