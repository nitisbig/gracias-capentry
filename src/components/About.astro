---
import { site, serviceGroups } from "../data/site";

const aboutImg = "/works/third.webp";

const stats = [
  { value: site.rating, label: "Google Rating" },
  { value: `${site.reviewCount}`, label: "Five-Star Reviews" },
  { value: "15+", label: "Services Offered" },
];
---

<!-- Taupe divider band -->
<section id="about" class="bg-band py-24 text-center sm:py-32">
  <div class="reveal mx-auto max-w-4xl px-6">
    <p
      class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.34em] text-white/70"
    >
      Why The Maintenance Man
    </p>
    <h2 class="heading-band mt-6 text-3xl sm:text-5xl">Superior Craftsmanship</h2>
    <p class="mx-auto mt-8 max-w-2xl leading-relaxed text-white/80">
      Five-star rated and built on referrals — every job is finished with the
      same precision, punctuality and care that earned {site.craftsman} a
      perfect {site.rating} across {site.reviewCount} reviews.
    </p>
  </div>
</section>

<!-- What We Do -->
<section class="bg-bg py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <!-- Image -->
      <div class="reveal relative">
        <div class="overflow-hidden">
          <img
            src={aboutImg}
            alt="A remodeled kitchen with fresh cabinets, counters and tile"
            class="aspect-[4/5] w-full object-cover"
            loading="lazy"
          />
        </div>
        <div
          class="absolute -bottom-6 -right-4 hidden border border-line bg-bg px-8 py-6 shadow-lg sm:block"
        >
          <p class="tracking-[0.2em] text-gold">★★★★★</p>
          <p class="mt-2 text-xs uppercase tracking-[0.2em] text-muted">
            Rated {site.rating} by clients
          </p>
        </div>
      </div>

      <!-- Copy -->
      <div class="reveal" style="transition-delay:120ms">
        <p class="eyebrow">What We Do</p>
        <div class="hairline mt-5"></div>
        <h3 class="heading-xl mt-6 text-3xl text-heading sm:text-4xl">
          One Team, <span class="text-gold">Every Detail</span>
        </h3>
        <p class="mt-7 text-lg leading-relaxed text-body">
          From a fresh coat of paint to decks, flooring and full remodels,
          {site.craftsman} and his team cover the full range of home
          improvement and repair:
        </p>

        <ul class="mt-7 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {
            serviceGroups.map((g) => (
              <li class="flex items-start gap-3 text-heading">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold" />
                <span class="text-sm font-medium uppercase tracking-[0.08em]">
                  {g.title}
                </span>
              </li>
            ))
          }
        </ul>

        <dl class="mt-10 grid grid-cols-3 gap-6 border-t border-line pt-8">
          {
            stats.map((s) => (
              <div>
                <dt class="font-display text-3xl font-light text-gold sm:text-4xl">
                  {s.value}
                </dt>
                <dd class="mt-1 text-xs uppercase tracking-[0.18em] text-muted">
                  {s.label}
                </dd>
              </div>
            ))
          }
        </dl>

        <a href="#services" class="btn-outline mt-10">View Services</a>
      </div>
    </div>
  </div>
</section>
